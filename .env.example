# Copy this file to .env and fill in real values.
# Used to send Account Settings' "Change Email" verification codes.
# For Gmail: EMAIL_HOST_USER is the full address, EMAIL_HOST_PASSWORD is a
# 16-character App Password (https://myaccount.google.com/apppasswords) —
# not the regular account password, which Gmail rejects for SMTP login.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
