# Copy this file to .env and fill in real values.
# SECRET_KEY: Django's cryptographic signing key (sessions, CSRF, password
# reset tokens, etc.) — generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never reuse a key that's ever been committed to version control.
SECRET_KEY=
# True for local dev (runserver). Must be False for any real deployment —
# leaving this True in production leaks stack traces/local variables on any
# unhandled error. Also gates the production-only cookie/transport hardening
# settings in settings.py (SESSION_COOKIE_SECURE etc.), which only kick in
# once this is False.
DEBUG=True
# Used to send Account Settings' "Change Email" and Forgot Password
# verification codes, via SendGrid's HTTP API (django-anymail) rather than
# raw SMTP -- SMTP was abandoned because Render's platform doesn't reliably
# support arbitrary outbound raw TCP connections, only HTTP(S) egress.
# Generate an API key at https://app.sendgrid.com (Settings > API Keys).
SENDGRID_API_KEY=
# Must be a verified sender identity in the SendGrid account (Settings >
# Sender Authentication > Single Sender Verification, or full domain auth)
# -- SendGrid rejects sends from an address it hasn't verified.
DEFAULT_FROM_EMAIL=
# Seconds to wait on the request to SendGrid before giving up. Keep this
# well under gunicorn's worker timeout (default 30s in production) so a
# stuck request fails fast with a clean error instead of the worker getting
# killed mid-request (which shows up to users as a bare 502).
EMAIL_TIMEOUT=10

# Points Django at PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DBNAME.
# Leave unset for local dev — settings.py then falls back to the original
# db.sqlite3 file, no Postgres install needed. On Render this is injected
# automatically (see render.yaml's `fromDatabase`); only set it by hand if
# testing against a local/external Postgres instance.
DATABASE_URL=
# Only needed for an external (non-Render-internal) Postgres connection that
# requires SSL — leave False for Render's internal DATABASE_URL and for
# local Postgres.
DATABASE_SSL_REQUIRE=False

# Comma-separated. Empty is fine locally (DEBUG=True lets Django auto-allow
# localhost/127.0.0.1). On Render, RENDER_EXTERNAL_HOSTNAME is injected
# automatically and appended in settings.py — only fill this in for a
# custom domain added later.
ALLOWED_HOSTS=
# Comma-separated, full origin including scheme (e.g. https://example.com).
# Same Render auto-detection as ALLOWED_HOSTS above — only needed for a
# custom domain.
CSRF_TRUSTED_ORIGINS=
